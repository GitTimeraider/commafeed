FROM ibm-semeru-runtimes:open-jdk-25.0.4.10-jre@sha256:a95258f9937f1dfe0a5adb381e37a71791398b3378c0ea1a7754bd399fb614ff
ARG TARGETARCH

EXPOSE 8082

# Install gosu (used by the entrypoint to drop from root to the PUID/PGID user)
ENV GOSU_VERSION=1.19
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates; \
    curl -fsSL -o /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/${GOSU_VERSION}/gosu-${TARGETARCH}"; \
    case "${TARGETARCH}" in \
        amd64) echo "52c8749d0142edd234e9d6bd5237dff2d81e71f43537e2f4f66f75dd4b243dd0  /usr/local/bin/gosu" | sha256sum -c -;; \
        arm64) echo "3a8ef022d82c0bc4a98bcb144e77da714c25fcfa64dccc57f6aba7ae47ff1a44  /usr/local/bin/gosu" | sha256sum -c -;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1;; \
    esac; \
    chmod +x /usr/local/bin/gosu; \
    apt-get purge -y --auto-remove curl; \
    rm -rf /var/lib/apt/lists/*

# Default user/group, overridable at runtime with the PUID/PGID environment variables
RUN groupadd -o -g 1000 commafeed \
    && useradd -o -u 1000 -g commafeed -M -d /commafeed commafeed \
    && mkdir -p /commafeed/data \
    && chown -R commafeed:commafeed /commafeed

VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
COPY commafeed-server/src/main/docker/entrypoint.sh /commafeed/entrypoint.sh
RUN chmod +x /commafeed/entrypoint.sh \
    && chown -R commafeed:commafeed /commafeed

WORKDIR /commafeed

ENTRYPOINT ["/commafeed/entrypoint.sh"]
CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
